{
  "name": "react-viewport-height",
  "version": "1.3.0",
  "description": "A React hook that returns 1% of the browser's inner window height and keeps it up to date.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimazuien/react-viewport-height.git"
  },
  "homepage": "https://github.com/dimazuien/react-viewport-height#readme",
  "keywords": [
    "react",
    "hook",
    "viewport",
    "scroll",
    "vh",
    "resize",
    "window",
    "screen",
    "mobile"
  ],
  "author": "Dima Zuien",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dimazuien/react-viewport-height/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "format": "prettier . --write",
    "lint": "eslint --max-warnings=0 --no-warn-ignored --fix",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:spelling": "cspell lint --no-progress .",
    "prepare": "husky",
    "release": "semantic-release",
    "reset": "rm -rf node_modules dist coverage junit.xml",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit --pretty --project tsconfig.json && tsc --noEmit --pretty --project .agents",
    "typecheck:watch": "tsc --watch --noEmit --incremental --preserveWatchOutput --pretty --project tsconfig.json"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/core": "1.2.1",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.11",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-istanbul": "5.1.1",
    "@vitest/eslint-plugin": "1.6.28",
    "commitizen": "4.3.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "cspell": "10.5.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-baseline-js": "0.7.7",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-package-json": "1.14.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.2",
    "markdownlint-cli2": "0.24.2",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semantic-release": "25.0.9",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  }
}
