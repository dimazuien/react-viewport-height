{
  "type": "commonjs",
  "name": "react-viewport-height",
  "version": "1.3.0",
  "description": "A React hook that returns 1% of the browser's inner window height and keeps it up to date.",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimazuien/react-viewport-height.git"
  },
  "homepage": "https://github.com/dimazuien/react-viewport-height#readme",
  "keywords": [
    "react",
    "hook",
    "viewport",
    "scroll",
    "vh",
    "resize",
    "window",
    "screen",
    "mobile"
  ],
  "author": "Dima Zuien",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dimazuien/react-viewport-height/issues"
  },
  "source": "src/index.ts",
  "main": "lib/index.js",
  "typings": "index.d.ts",
  "files": [
    "lib",
    "index.d.ts"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "build": "webpack",
    "dts": "npm-dts generate -e src/index --tsc=\"-p tsconfig.build.json\"",
    "lint": "eslint --max-warnings=0 --no-warn-ignored --fix",
    "prepare": "husky",
    "release": "semantic-release",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit --pretty --project tsconfig.json",
    "typecheck:watch": "tsc --watch --noEmit --incremental --preserveWatchOutput --pretty --project tsconfig.json"
  },
